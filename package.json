{
  "name": "tanstack-starter",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier --write .",
    "fix:lint": "eslint --fix .",
    "prettier": "prettier --check .",
    "test": "run-s test:*",
    "test:check": "tsc --noEmit --skipLibCheck",
    "test:lint": "eslint .",
    "test:prettier": "prettier . --list-different",
    "preview": "$npm_execpath build && wrangler dev",
    "deploy": "$npm_execpath build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface Env"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@tanstack/react-router": "^1.128.0",
    "@tanstack/react-start": "^1.128.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/eslint-plugin-router": "^1.125.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/eslint-plugin": "^1.3.4",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-functional": "^9.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-unicorn": "^59.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.25.0"
  }
}
